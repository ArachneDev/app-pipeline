# Breaks the contract on purpose: writes to the image filesystem at start. tests/test_contract.py only.
FROM docker.io/library/busybox:1.37.0-musl@sha256:5624bb6777cf469b1fb50ae3f981b15d2715ee2fffaf20b9998cfb7843726835
ARG VERSION=dev
RUN mkdir /www && printf '%s\n' "$VERSION" > /www/healthz && chown -R 65534:65534 /www
USER 65534:65534
CMD ["sh", "-c", "date > /www/started && exec httpd -f -p \"$PORT\" -h /www"]
