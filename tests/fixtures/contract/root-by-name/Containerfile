# Breaks the contract on purpose: USER names an account that /etc/passwd maps to UID 0. tests/test_contract.py only.
FROM docker.io/library/busybox:1.37.0-musl@sha256:5624bb6777cf469b1fb50ae3f981b15d2715ee2fffaf20b9998cfb7843726835
ARG VERSION=dev
RUN mkdir /www && printf '%s\n' "$VERSION" > /www/healthz && echo 'app:x:0:0::/:/bin/sh' >> /etc/passwd
USER app
CMD ["sh", "-c", "exec httpd -f -p \"$PORT\" -h /www"]
