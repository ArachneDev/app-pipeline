# Meets the contract only when its sample secrets file is mounted: it refuses to
# start without GREETING in /run/secrets/app.json. tests/test_contract.py only.
FROM docker.io/library/busybox:1.37.0-musl@sha256:5624bb6777cf469b1fb50ae3f981b15d2715ee2fffaf20b9998cfb7843726835
ARG VERSION=dev
RUN mkdir /www && printf '%s\n' "$VERSION" > /www/healthz
USER 65534:65534
CMD ["sh", "-c", "grep -q GREETING /run/secrets/app.json || { echo 'GREETING missing from /run/secrets/app.json'; exit 3; }; exec httpd -f -p \"$PORT\" -h /www"]
